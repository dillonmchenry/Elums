# Machine-specific / secrets
.env
.env.*
!.env.example
*.pem
*.key
id_*
*_rsa
*_ed25519

# Data and models — VM-only / regenerable, never committed.
# Anchored to repo root (leading /): an unanchored "models/" also matched
# elums/models/, Python package of the ingest_jobs model — it was silently
# excluded from `git add` until this was caught directly Oct 3 2026 (M4).
# `/data/*` rather than `/data/` so git still descends into the directory
# to evaluate the re-inclusion rules below — a bare `/data/` exclusion
# stops traversal entirely and a nested `!` negation silently has no
# effect, verified directly Oct 4 2026 (N5).
/data/*
# Exception, same pattern as !.env.example above: this is provenance/
# attribution documentation, not regenerable data.
!/data/samples/
/data/samples/*
!/data/samples/README.md
/models/

# Python
__pycache__/
*.pyc
.venv/
venv/
.venv-tools/
.scratch-*/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend
node_modules/
frontend/dist/
.vite/

# Build artifacts (anchored — same lesson as /models/ above)
/dist/
/build/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
