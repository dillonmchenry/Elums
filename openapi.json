              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "F0 Blob Sha256"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "instrumental_blob_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instrumental Blob Sha256"
          },
          "note_count": {
            "title": "Note Count",
            "type": "integer"
          },
          "peaks_blob_sha256": {
            "anyOf": [
              {
