      "SongBundlePublic": {
        "description": "Tue Oct 6 (T3): `GET /api/songs/{song_id}` \u2014 song metadata plus\nthe chart/peaks/stem blob hashes the karaoke page needs. Deliberately\nNOT the chart's own contents inline \u2014 the client fetches that\nseparately through `/blobs/<chart_blob_sha256>` (Caddy's Range-request\npath), same as every other blob.",
        "properties": {
          "artist": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Artist"
          },
