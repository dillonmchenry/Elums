# Dev-only image for the `frontend` compose service — HMR via a bind
# mount, not a production build. The actual production artifact is
# `npm run build`'s dist/ output, served by Caddy directly (not this
# image) once there's something worth demoing statically — see M5 of
# IMPLEMENTATION_PLAN_2026-10-03.md.
FROM node:22-alpine
WORKDIR /app
CMD ["sh", "-c", "npm install && npm run dev -- --host 0.0.0.0 --port 5173"]
