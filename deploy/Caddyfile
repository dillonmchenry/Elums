# M4: proxy only — no SPA yet (M5). The `ssh -L 8080` tunnel pattern makes
# this an asset: browsers treat localhost as a secure context regardless of
# scheme, so getUserMedia/Service Workers/AudioWorklet all work over plain
# HTTP through the tunnel (ELUMS_TECHNICAL_APPROACH.md §11.6). No TLS block
# here on purpose.
:8080 {
	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		respond "Elums — frontend scaffolded in M5" 200
	}
}
