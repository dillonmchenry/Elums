# Copy to .env on each machine. Nothing machine-specific belongs anywhere
# else — see elums/config.py and IMPLEMENTATION_PLAN_2026-10-03.md M4.

DATABASE_URL=postgresql+psycopg://elums:elums@db:5432/elums
VALKEY_URL=valkey://valkey:6379/0

BLOB_ROOT=/data/blobs
MODEL_ROOT=/app/models
DATA_ROOT=/data

# false for the ssh -L tunnel (today); true once the named Cloudflare
# Tunnel is live (Thu Oct 8) — see M6.
SESSION_COOKIE_SECURE=false

# Set locally only; never committed. No call sites exist before Fri Oct 9.
OPENROUTER_API_KEY=

# Which GPU architecture this machine's gpu-worker expects — sm_86 locally,
# sm_120 on the Smule VM. Verified in M3 (docs/vm-baseline.md).
EXPECTED_SM_ARCH=sm_86
